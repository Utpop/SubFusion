# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller output
# build/ holds intermediate .pyc/.toc/.pyz files and dist/ the packed
# executable; both are regenerated by 打包EXE.bat, so they are not tracked.
build/
dist/
*.spec

# Distribution / packaging
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor and OS noise
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# Runtime artefacts produced by the self tests
_selftest/**/out/
_selftest/**/*.log
_selftest/run_tests_report.txt
*.tmp
