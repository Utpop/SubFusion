<Project Sdk="Microsoft.NET.Sdk">

  <!--
    纯业务逻辑层：不引用任何 UI / WinRT / WindowsAppSDK 类型。
    目标 net8.0，便于被 WinUI 3 主程序、自检控制台程序同时引用。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>SubFusion.Core</RootNamespace>
    <AssemblyName>SubFusion.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 自检要直接验证「哪些解码输出算真错误」这条判定，判定本身不宜因测试而变成公开 API -->
    <InternalsVisibleTo Include="SubFusion.SelfTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Core 默认不含 GB18030 / Big5 / Shift-JIS 等旧代码页，需要微软官方代码页提供程序 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

</Project>
