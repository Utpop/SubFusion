<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SubFusion.App.Controls.TimelineRuler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <!--
      时间轴选择条：整条轨道表示整个文件的时长，
      两侧拖拽手柄选出裁剪区间，区间内部可整体平移。

      为什么不用两个 Slider 叠在一起：两个独立 Slider 会互相穿过，
      而且它们的拇指位置与「区间」这个概念对不上，用户很难看出选了哪一段。
      这里画成一整条轨道 + 高亮区间，选择结果一眼可见。
    -->
    <Grid x:Name="RootGrid" Height="56" Background="Transparent"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCanceled="OnPointerReleased"
          PointerCaptureLost="OnPointerReleased"
          SizeChanged="OnSizeChanged">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
        </Grid.RowDefinitions>

        <!-- 轨道 -->
        <Border x:Name="TrackBar" Height="10" CornerRadius="5" VerticalAlignment="Center"
                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                Opacity="0.45" />

        <!-- 已选区间 -->
        <Border x:Name="SelectionBar" Height="10" CornerRadius="5" VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                HorizontalAlignment="Left" />

        <!-- 起点手柄 -->
        <Border x:Name="StartHandle" Width="10" CornerRadius="5" HorizontalAlignment="Left"
                Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                ToolTipService.ToolTip="拖动调整起点" />

        <!-- 终点手柄 -->
        <Border x:Name="EndHandle" Width="10" CornerRadius="5" HorizontalAlignment="Left"
                Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                ToolTipService.ToolTip="拖动调整终点" />

        <!-- 关键帧刻度：让用户看见「切点只能落在这里」 -->
        <Canvas x:Name="TickLayer" Height="10" VerticalAlignment="Center" IsHitTestVisible="False" />

        <!-- 刻度文字：起点 / 终点 / 总长 -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <TextBlock x:Name="StartLabel" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EndLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TotalLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
