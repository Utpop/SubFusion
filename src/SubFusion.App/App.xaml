<Application
    x:Class="SubFusion.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SubFusion.App.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 原生 Fluent 2 控件资源 -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 应用自己的设计令牌（颜色 / 间距 / 字号）与共享控件样式 -->
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器：状态色、可见性、图标 -->
            <converters:StateTagToBrushConverter x:Key="StateTagToBrush" />
            <converters:TaskStateToBrushConverter x:Key="TaskStateToBrush" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <converters:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
            <converters:NotEmptyToVisibleConverter x:Key="NotEmptyToVisible" />
            <converters:BoolToGlyphConverter x:Key="BoolToGlyph" />
            <converters:BoolToInfoBarSeverityConverter x:Key="BoolToSeverity" />
            <converters:LossyToBrushConverter x:Key="LossyToBrush" />
            <converters:BytesToImageConverter x:Key="BytesToImage" />
            <converters:ResultOkToSeverityConverter x:Key="ResultOkToSeverity" />
            <!-- 把 copy / libx264 这类技术值翻译成大白话，只影响显示，不改变实际设置值 -->
            <converters:TechLabelConverter x:Key="TechLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
