<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    WinUI 3 官方推荐的 unpackaged + self-contained + single-file 发布配置。

    验证环境：.NET SDK 10.0.403（工程目标 net8.0） + Microsoft.WindowsAppSDK 2.6.5。
    该版本自带 Microsoft.WindowsAppSDK.SingleFile.targets，硬性要求：
      EnableMsixTooling=true              生成嵌入版 resources.pri
      WindowsPackageType=None            仅支持 unpackaged
      IncludeAllContentForSelfExtract=true 原生 DLL SxS 重定向与首次运行释放
      WindowsAppSDKSelfContained=true     自动启用 UndockedRegFreeWinRT 的 ModuleInitializer
      SelfContained=true                  不依赖目标机 .NET Runtime
      RuntimeIdentifier=win-x64

    注意：默认目录发布（README/dist）不受本文件影响；只有显式指定
    -p:PublishProfile=SingleFile 时才启用单文件模式。
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <!-- PDB 嵌入程序集，而不是作为发布目录里的散落文件 -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 未启用裁剪 / Native AOT；WinUI 3 XAML 反射与 WinRT 激活不兼容激进裁剪 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\SingleExe\</PublishDir>
    <!--
      NETSDK1244：SDK 建议去掉 IncludeAllContentForSelfExtract，改用默认的内存内单文件。
      但 Windows App SDK 的单文件 targets 依赖「全部内容解压到磁盘 + SxS 重定向」来定位
      原生 DLL 与嵌入的 resources.pri，去掉该属性会让发布产物无法启动。
      这里保留属性并抑制这一条针对性警告，不掩盖其它警告。
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1244</MSBuildWarningsAsMessages>
  </PropertyGroup>
</Project>
