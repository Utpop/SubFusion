<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SubFusion.App.Pages.SubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SubFusion.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 页头与命令条 ==================== -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="字幕合并" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="把外挂字幕合进视频。先加视频，字幕会自动配上，不满意可以手动改。"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Width="18" Height="18" />
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                        OverflowButtonVisibility="Auto" Background="Transparent" Padding="0">
                <AppBarButton Label="添加视频" Command="{x:Bind ViewModel.AddVideosCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="添加字幕" Command="{x:Bind ViewModel.AddSubtitlesCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="添加文件夹" Command="{x:Bind ViewModel.AddFolderCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="重新匹配" Command="{x:Bind ViewModel.RematchCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="字幕轨" Command="{x:Bind ViewModel.EditSubtitlesCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="移除选中" Command="{x:Bind ViewModel.RemoveSelectedCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="清空" Command="{x:Bind ViewModel.ClearAllCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="打开视频所在文件夹" Command="{x:Bind ViewModel.OpenSelectedVideoFolderCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8F1;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="打开输出文件" Command="{x:Bind ViewModel.OpenSelectedOutputCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="打开输出目录" Command="{x:Bind ViewModel.OpenOutputDirCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="导出报告" Command="{x:Bind ViewModel.ExportReportCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- ==================== 文件列表 ==================== -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" MinWidth="420">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Padding="12,10" ColumnSpacing="8"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="2*" MinWidth="160" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="视频" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="时长" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="分辨率" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="字幕轨" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="进度" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                </Grid>

                <!-- 列表 -->
                <ListView x:Name="RowsList" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Rows}"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource TaskListItemStyle}"
                          ScrollViewer.HorizontalScrollMode="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="RowsList_SelectionChanged"
                          DoubleTapped="RowsList_DoubleTapped"
                          RightTapped="RowsList_RightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubtitleRowViewModel">
                            <Grid Padding="12,6" ColumnSpacing="8" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="2*" MinWidth="160" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind FullPath, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DurationText, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Resolution, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SubsText, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" FontSize="12"
                                              Foreground="{x:Bind StateTag, Mode=OneWay, Converter={StaticResource StateTagToBrush}}" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                                               Foreground="{x:Bind StateTag, Mode=OneWay, Converter={StaticResource StateTagToBrush}}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="5" Text="{x:Bind ProgressText, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="设置字幕轨…" Command="{x:Bind ViewModel.EditSubtitlesCommand}" />
                            <MenuFlyoutItem Text="移除选中" Command="{x:Bind ViewModel.RemoveSelectedCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="打开视频所在文件夹"
                                            Command="{x:Bind ViewModel.OpenSelectedVideoFolderCommand}" />
                            <MenuFlyoutItem Text="打开输出文件"
                                            Command="{x:Bind ViewModel.OpenSelectedOutputCommand}" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>

                <!-- 空状态 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" Margin="24"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="40"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="还没有添加视频" Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                               Text="把视频、字幕或文件夹拖到窗口里，或使用上方「添加视频 / 添加字幕 / 添加文件夹」。匹配到的字幕会自动挂载到对应视频。" />
                </StackPanel>

                <!-- 运行日志（可折叠） -->
                <Expander Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="False" Margin="0,4,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="运行日志" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                      Padding="8">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12"
                                                   IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Row="1" Content="清空日志" Style="{StaticResource ToolbarButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                Command="{x:Bind ViewModel.ClearLogCommand}" />
                    </Grid>
                </Expander>
            </Grid>
        </Border>

        <!-- ==================== 参数面板 ==================== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Width="340"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">

                <!-- 输出 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="输出" Style="{StaticResource SectionTitleStyle}" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="输出格式" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.Containers}"
                                          SelectedItem="{x:Bind ViewModel.Container, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="字幕怎么放" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.Modes}"
                                          SelectedItem="{x:Bind ViewModel.Mode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}"
                                             PlaceholderText="选择输出目录" />
                                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{x:Bind ViewModel.ChooseOutputDirCommand}" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="加文件时自动记住文件所在目录" IsChecked="{x:Bind ViewModel.SyncOutputDir, Mode=TwoWay}"
                                              ToolTipService.ToolTip="开启后，添加不同目录的文件时自动把输出目录同步到源目录" />
                                    <Button Grid.Column="1" Content="用源目录" Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{x:Bind ViewModel.UseSourceDirCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock Text="文件名末尾加" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.Suffix, Mode=TwoWay}"
                                         PlaceholderText="例如 _sub（留空则默认）" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
                                <CheckBox Content="保留视频里本来就有的字幕" IsChecked="{x:Bind ViewModel.KeepExistingSubs, Mode=TwoWay}" />
                                <CheckBox Content="保留文件的标题、作者等信息" IsChecked="{x:Bind ViewModel.KeepMetadata, Mode=TwoWay}" />
                                <CheckBox Content="名字一样时直接覆盖，不再询问" IsChecked="{x:Bind ViewModel.Overwrite, Mode=TwoWay}" />
                                <CheckBox Content="做完后检查文件有没有坏" IsChecked="{x:Bind ViewModel.Verify, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">
                                <CheckBox Content="完成后直接用新文件替换原视频（会删原文件）" IsChecked="{x:Bind ViewModel.ReplaceSource, Mode=TwoWay}" />
                                <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.ReplaceSource, Mode=OneWay}"
                                         Title="会删除原始文件"
                                         Message="仅在合并完成且校验通过时删除原视频与已合并字幕；校验失败则保留原件。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 编码 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="编码方式" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="视频编码方式" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Vcodecs}"
                                          SelectedItem="{x:Bind ViewModel.Vcodec, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="音频编码方式" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Acodecs}"
                                          SelectedItem="{x:Bind ViewModel.Acodec, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="画质（数字越小越清晰、文件越大）" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Minimum="0" Maximum="51" SmallChange="1" SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="编码速度" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Presets}"
                                          SelectedItem="{x:Bind ViewModel.Preset, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="同时处理几个" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Minimum="1" Maximum="4" SmallChange="1" SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.Workers, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CaptionStyle}"
                                       Text="画质和速度只在需要重新编码时才有作用；做硬字幕一定会重新编码。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 字幕与匹配 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="字幕设置" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox Content="自动修正字幕乱码（转成通用编码）" IsChecked="{x:Bind ViewModel.ConvertEncoding, Mode=TwoWay}" />
                        <CheckBox Content="连子文件夹里的文件一起找" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}" />
                        <CheckBox Content="硬字幕时把每条字幕都烧进去" IsChecked="{x:Bind ViewModel.HardMulti, Mode=TwoWay}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="字幕匹配严格度" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox Minimum="0.4" Maximum="1.0" SmallChange="0.02" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.Threshold, Mode=TwoWay}" />
                        </StackPanel>
                        <InfoBar Severity="Informational" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HintVisible, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.HintText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 底部操作栏 ==================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="开始处理" Style="{StaticResource AccentButtonStyle}" Padding="28,8"
                        Command="{x:Bind ViewModel.StartCommand}" />
                <Button Grid.Column="1" Content="停止" Command="{x:Bind ViewModel.StopCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}"
                                 Maximum="{x:Bind ViewModel.OverallMaximum, Mode=OneWay}" Height="4" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.ToolDetail, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                           MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Page>
