<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SubFusion.App.Pages.TaskCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:SubFusion.App.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 页头 ==================== -->
        <Grid Grid.Row="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="任务中心" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="字幕合并与视频合并任务的统一状态、进度与诊断。状态全部来自 Core 的真实回调。"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                            OverflowButtonVisibility="Auto" Background="Transparent" Padding="0">
                    <AppBarButton Label="取消选中" Command="{x:Bind ViewModel.CancelSelectedCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="全部取消" Command="{x:Bind ViewModel.CancelAllCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="清除已结束" Command="{x:Bind ViewModel.ClearFinishedCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="打开输出目录" Command="{x:Bind ViewModel.OpenOutputCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="复制诊断日志" Command="{x:Bind ViewModel.CopyDiagnosticsCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="FilterBox" ItemsSource="{x:Bind ViewModel.Filters}" SelectedIndex="0"
                              SelectionChanged="FilterBox_SelectionChanged" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 任务列表 + 详情 ==================== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="12,10" ColumnSpacing="8"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="2*" MinWidth="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Column="1" Text="任务" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="进度" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    </Grid>

                    <ListView x:Name="TasksList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Filtered}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource TaskListItemStyle}"
                              SelectionChanged="TasksList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:TaskRecord">
                                <Grid Padding="12,6" ColumnSpacing="8" MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="2*" MinWidth="180" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="{x:Bind StateGlyph}" FontSize="14"
                                              VerticalAlignment="Center"
                                              Foreground="{x:Bind State, Converter={StaticResource TaskStateToBrush}}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Stage}" Style="{StaticResource CaptionStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind KindText}"
                                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StateText}" FontSize="11"
                                                   Foreground="{x:Bind State, Converter={StaticResource TaskStateToBrush}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3">
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" />
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" Margin="24"
                                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                        <FontIcon Glyph="&#xE9D5;" FontSize="40"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                                   Style="{StaticResource EmptyStateBodyStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="任务详情" Style="{StaticResource SectionTitleStyle}" Margin="16,14,16,8" />

                    <!-- 已选中：概要与诊断日志。未选中时整体折叠，与下方空状态互斥，不会重叠。 -->
                    <Grid x:Name="DetailPanel" Grid.Row="1"
                          Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,0,16,8" Spacing="6"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedInput, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="输出：" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedOutput, Mode=OneWay}"
                                       Style="{StaticResource MonoTextStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedOutput, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind ViewModel.SelectedKind, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedState, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{x:Bind ViewModel.SelectedStateBrushKey, Mode=OneWay, Converter={StaticResource TaskStateToBrush}}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedElapsed, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </StackPanel>

                        <Grid Grid.Row="1" Margin="16,0,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="诊断日志" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                          Padding="8" MinHeight="160">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedLog, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="11"
                                                       IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 未选中：整块空状态占据详情区，与上面的详情内容互斥 -->
                    <StackPanel x:Name="DetailEmptyState" Grid.Row="1" VerticalAlignment="Center"
                                Spacing="10" Margin="24"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                        <FontIcon Glyph="&#xE9D5;" FontSize="36"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="选择一个任务查看详情" Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                                   Text="左侧列表中选中一条任务，这里会显示它的输出位置、完成状态与完整诊断日志。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
