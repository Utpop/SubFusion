<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SubFusion.App.Pages.MergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SubFusion.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 页头与命令条 ==================== -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="视频合并" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="列表顺序即合并顺序。参数一致的输入直接无损拼接，否则按设置统一编码。"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.Analyzing, Mode=OneWay}" Width="18" Height="18" />
                    <TextBlock Text="{x:Bind ViewModel.InputCountText, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                        OverflowButtonVisibility="Auto" Background="Transparent" Padding="0">
                <AppBarButton Label="添加视频" Command="{x:Bind ViewModel.AddInputsCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="添加文件夹" Command="{x:Bind ViewModel.AddFolderCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="上移" Command="{x:Bind ViewModel.MoveUpCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74A;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="下移" Command="{x:Bind ViewModel.MoveDownCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="按名称排序" Command="{x:Bind ViewModel.SortByNameCommand}"
                              ToolTipService.ToolTip="按文件名自然排序（第2集 排在 第10集 之前）">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="识别无损组合" Command="{x:Bind ViewModel.DetectGroupsCommand}"
                              ToolTipService.ToolTip="找出可以直接无损拼接的视频组合">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="移除选中" Command="{x:Bind ViewModel.RemoveSelectedCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE738;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="清空" Command="{x:Bind ViewModel.ClearInputsCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="打开输出目录" Command="{x:Bind ViewModel.OpenOutputFolderCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;"/></AppBarButton.Icon>
                </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- ==================== 输入列表 ==================== -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" MinWidth="420">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,10" ColumnSpacing="8"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      Visibility="{x:Bind ViewModel.HasInputs, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" MinWidth="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="文件（顺序即合并顺序）" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="分辨率" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="时长" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="视频" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="音频 / 章节标题" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                </Grid>

                <!--
                  鼠标拖拽排序：CanDragItems + CanReorderItems 由 ListView 完成行重排，
                  但重排只作用于可见容器，不会回写到 ViewModel.Inputs（合并顺序的来源），
                  因此用拖拽开始/结束事件把最终顺序同步回 ViewModel。
                  AllowDrop 保留，用于从资源管理器拖文件进来追加。
                -->
                <ListView x:Name="InputsList" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Inputs}"
                          SelectionMode="Extended"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                          DragItemsStarting="InputsList_DragItemsStarting"
                          DragItemsCompleted="InputsList_DragItemsCompleted"
                          Drop="InputsList_Drop"
                          ItemContainerStyle="{StaticResource TaskListItemStyle}"
                          SelectionChanged="InputsList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MergeInputViewModel">
                            <Grid Padding="12,6" ColumnSpacing="8" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="160" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Text="{x:Bind Error}" Style="{StaticResource CaptionStyle}"
                                               Foreground="{ThemeResource StatusDangerBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind Failed, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{x:Bind Resolution}"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText}"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind CodecText}" Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FrameRateText}" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind AudioText}" Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox Text="{x:Bind ChapterTitle, Mode=TwoWay}" FontSize="12"
                                             PlaceholderText="章节标题" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" Margin="24"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <FontIcon Glyph="&#xE714;" FontSize="40"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="还没有添加视频" Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                               Text="把视频拖到窗口里，或使用「添加视频 / 添加文件夹」。列表顺序就是合并顺序，可拖动或用上移/下移调整。" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 参数与分析 ==================== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Width="360"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">

                <!-- 处理策略（来自 Core 的真实分析） -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="处理策略" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StrategyText, Mode=OneWay}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StrategyDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" />

                        <!-- 严重级别与文案都由 ViewModel 决定：仅时间轴差异只是重封装，不该显示成错误 -->
                        <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasReasons, Mode=OneWay}"
                                 Severity="{x:Bind ViewModel.ReasonsAreBlocking, Mode=OneWay, Converter={StaticResource BoolToSeverity}}"
                                 Title="{x:Bind ViewModel.ReasonTitle, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ReasonIntro, Mode=OneWay}" />
                        <!-- 差异按"要不要重编码"分组：一长串并列差异看不出重点，
                             真正决定画质有没有损失的是其中有没有"必须重新编码"那一组。 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReasonGroups}"
                                      Visibility="{x:Bind ViewModel.HasReasons, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MergeReasonGroupViewModel">
                                    <StackPanel Spacing="2" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- 会重编码的那一组用警示色，其余保持普通色：
                                                 颜色本身就在回答"画质会不会变差"。 -->
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{x:Bind IsLossy, Converter={StaticResource LossyToBrush}}" />
                                            <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Intro}" Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{x:Bind Details}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionStyle}"
                                                               Margin="12,1,0,0" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <InfoBar Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.AnalysisError, Mode=OneWay, Converter={StaticResource NotEmptyToBool}}"
                                 Message="{x:Bind ViewModel.AnalysisError, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 可无损拼接的组合（来自 Core 的 MergeGrouping） -->
                <Border Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind ViewModel.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="可无损拼接的组合" Style="{StaticResource SectionTitleStyle}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.Grouping, Mode=OneWay}" Width="14" Height="14" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.GroupSummary, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MergeGroupViewModel">
                                    <StackPanel Spacing="2" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center" />
                                            <!-- x:Bind 在 DataTemplate 内绑定的是数据项本身，命令从页面 ViewModel 取仍需走根元素路径；
                                                 此处用 Tag 传递组合对象，由 Click 处理器转交给 ViewModel，避免两套绑定混用。 -->
                                            <Button Content="用这组" FontSize="11" Padding="8,2"
                                                    Tag="{x:Bind}"
                                                    Click="UseGroup_Click" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Signature}" Style="{StaticResource CaptionStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- 只在需要额外一步重封装时才出现，说明"为什么不能直接拼" -->
                                        <TextBlock Text="{x:Bind ReasonText}" Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind ReasonText, Converter={StaticResource NotEmptyToBool}, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind FileListText}" Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 输出 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="输出" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="容器" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Containers}"
                                      SelectedItem="{x:Bind ViewModel.Container, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}"
                                         PlaceholderText="选择输出目录" />
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{x:Bind ViewModel.ChooseOutputDirectoryCommand}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="文件名" Style="{StaticResource FieldLabelStyle}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.OutputName, Mode=TwoWay}" PlaceholderText="merged" />
                                <Button Grid.Column="1" Content="另存为" Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{x:Bind ViewModel.ChooseOutputFileCommand}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OutputPath, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.OutputPath, Mode=OneWay}" />
                        <CheckBox Content="目标已存在时覆盖" IsChecked="{x:Bind ViewModel.Overwrite, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 编码 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="重新编码" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox Content="允许自动重新编码" IsChecked="{x:Bind ViewModel.AllowReencode, Mode=TwoWay}"
                                  ToolTipService.ToolTip="关闭后，输入参数不一致时任务会直接失败并列出原因" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="视频编码器" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Codecs}"
                                          SelectedItem="{x:Bind ViewModel.Codec, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="preset" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Presets}"
                                          SelectedItem="{x:Bind ViewModel.Preset, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="CRF" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Minimum="0" Maximum="51" SmallChange="1" SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="音频处理" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.AudioStrategies}"
                                          SelectedItem="{x:Bind ViewModel.AudioStrategyText, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock Text="分辨率适配" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Fits}"
                                          SelectedItem="{x:Bind ViewModel.Fit, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="Contain 完整显示并补边；Cover 填满并裁切；Stretch 直接拉伸。目标分辨率与帧率由 Core 按输入取最大值。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 完成后处理：删源是不可逆操作，单独成卡并与普通选项隔开 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="完成后处理" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox Content="校验输出后删除源文件"
                                  IsChecked="{x:Bind ViewModel.DeleteSource, Mode=TwoWay}"
                                  ToolTipService.ToolTip="合并成功且输出通过全片解码校验后，删除参与合并的原始视频。不可撤销。" />
                        <InfoBar Severity="Warning" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.DeleteSource, Mode=OneWay}"
                                 Title="删除前会先证明输出完好"
                                 Message="合并完成后对整个输出做一次全片解码校验（不只是开头和结尾）。只有整段都能完整解码才会删除源文件；校验不通过时源文件一律保留。此操作不可撤销。" />
                    </StackPanel>
                </Border>

                <!-- 章节与校验 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="章节与校验" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox Content="为每个输入生成 MKV 章节"
                                  IsChecked="{x:Bind ViewModel.AutoChapters, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.ChaptersAvailable, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="章节标题在左侧每个文件的「章节标题」里编辑；时间轴由 Core 按最终输出实际时长归一化，写入后回读校验。" />
                        <CheckBox Content="完成后校验输出文件（流结构 / 时长 / 章节 / 解码）"
                                  IsChecked="{x:Bind ViewModel.VerifyOutput, Mode=TwoWay}" />

                        <CheckBox Content="只重新编码参数不一致的片段"
                                  IsChecked="{x:Bind ViewModel.PartialReencode, Mode=TwoWay}"
                                  ToolTipService.ToolTip="大多数片段参数一致时，只重编码不合群的那几个，其余保持原样（不重新编码）。默认开启。" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="开启后：能找到「多数派」时只重编码少数片段，保留片段画质逐比特不变。重编码后会重新核对这些片段确实能拼接；核对不通过会自动退回全量重编码。" />

                        <CheckBox Content="无损拼接失败时自动改用重新编码重试"
                                  IsChecked="{x:Bind ViewModel.AutoFallbackOnFailure, Mode=TwoWay}"
                                  ToolTipService.ToolTip="默认关闭。参数一致时直接拼接极少失败，真失败通常是源文件本身有问题。" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="关闭时（推荐）：直接拼接失败会立刻报错并说明原因，不浪费一次长时间重编码。开启后：失败时自动重编码整批素材再试一次，耗时显著增加。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 底部操作栏 ==================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="开始合并" Style="{StaticResource AccentButtonStyle}" Padding="28,8"
                        Command="{x:Bind ViewModel.StartCommand}" />
                <Button Grid.Column="1" Content="取消" Command="{x:Bind ViewModel.CancelCommand}"
                        IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />

                <StackPanel Grid.Column="2" Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.StageText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProgressDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Height="4" />
                    <InfoBar Severity="Success" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ResultText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>