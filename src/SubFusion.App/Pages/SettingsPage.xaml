<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SubFusion.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="这里的改动会自动保存，下次打开程序依然有效；字幕合并和视频合并页面会立刻跟着变。"
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">

                <!-- ==================== 外观 ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="外观与主题" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="应用主题" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <RadioButton Content="跟随系统" IsChecked="{x:Bind ViewModel.IsSystemTheme, Mode=TwoWay}" GroupName="Theme" />
                                <RadioButton Content="浅色" IsChecked="{x:Bind ViewModel.IsLightTheme, Mode=TwoWay}" GroupName="Theme" />
                                <RadioButton Content="深色" IsChecked="{x:Bind ViewModel.IsDarkTheme, Mode=TwoWay}" GroupName="Theme" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="换主题后整个软件马上跟着变，不用重启。" />
                    </StackPanel>
                </Border>

                <!-- ==================== 媒体工具 ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="媒体工具" Style="{StaticResource SectionTitleStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ffmpeg" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay}"
                                     PlaceholderText="留空就自动找（一般不用填）" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.PickFfmpegCommand}" />

                            <TextBlock Grid.Row="1" Text="ffprobe" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FfprobePath, Mode=TwoWay}"
                                     PlaceholderText="留空就自动找（一般不用填）" />
                            <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.PickFfprobeCommand}" />

                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="重新检测" Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{x:Bind ViewModel.RecheckCommand}" />
                                <ProgressRing IsActive="{x:Bind ViewModel.Detecting, Mode=OneWay}" Width="16" Height="16" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SubtleSurfaceStyle}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind ViewModel.ToolReady, Mode=OneWay, Converter={StaticResource BoolToGlyph}}"
                                              FontSize="13" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ToolStatusText, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CapabilityText, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ==================== 字幕合并默认值 ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="字幕合并 · 默认设置" Style="{StaticResource SectionTitleStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="输出格式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Containers}"
                                      SelectedItem="{x:Bind ViewModel.Container, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="字幕方式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Modes}"
                                      SelectedItem="{x:Bind ViewModel.Mode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="视频编码方式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Vcodecs}"
                                      SelectedItem="{x:Bind ViewModel.Vcodec, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="音频编码方式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Acodecs}"
                                      SelectedItem="{x:Bind ViewModel.Acodec, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="画质（数字越小越清晰、文件越大）" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="编码速度" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Presets}"
                                      SelectedItem="{x:Bind ViewModel.Preset, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="同时处理几个" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="4" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.Workers, Mode=TwoWay}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="文件名末尾加" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{x:Bind ViewModel.Suffix, Mode=TwoWay}"
                                     PlaceholderText="例如 _sub" />

                            <TextBlock Grid.Row="4" Text="字幕匹配严格度" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox Grid.Row="4" Grid.Column="1" Minimum="0.4" Maximum="1.0" SmallChange="0.02"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.Threshold, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Spacing="2">
                            <CheckBox Content="自动修正字幕乱码（转成通用编码）" IsChecked="{x:Bind ViewModel.ConvertEncoding, Mode=TwoWay}" />
                            <CheckBox Content="连子文件夹里的文件一起找" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}" />
                            <CheckBox Content="保留视频里本来就有的字幕" IsChecked="{x:Bind ViewModel.KeepExistingSubs, Mode=TwoWay}" />
                            <CheckBox Content="保留文件的标题、作者等信息" IsChecked="{x:Bind ViewModel.KeepMetadata, Mode=TwoWay}" />
                            <CheckBox Content="名字一样时直接覆盖，不再询问" IsChecked="{x:Bind ViewModel.Overwrite, Mode=TwoWay}" />
                            <CheckBox Content="做完后检查文件有没有坏" IsChecked="{x:Bind ViewModel.Verify, Mode=TwoWay}" />
                            <CheckBox Content="硬字幕时把每条字幕都烧进去" IsChecked="{x:Bind ViewModel.HardMulti, Mode=TwoWay}" />
                            <CheckBox Content="完成后直接用新文件替换原视频（会删原文件）" IsChecked="{x:Bind ViewModel.ReplaceSource, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认输出目录" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}"
                                     PlaceholderText="留空则在每一次任务时选择" />
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.ChooseSubtitleOutputDirCommand}" />
                        </Grid>
                        <CheckBox Content="加文件时自动把保存位置改成文件所在目录"
                                  IsChecked="{x:Bind ViewModel.SyncOutputDir, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- ==================== 视频合并默认值 ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="视频合并 · 默认设置" Style="{StaticResource SectionTitleStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="输出格式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.MergeContainers}"
                                      SelectedItem="{x:Bind ViewModel.MergeContainer, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="视频编码方式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.MergeCodecs}"
                                      SelectedItem="{x:Bind ViewModel.MergeCodec, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="画质（数字越小越清晰、文件越大）" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.MergeCrf, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="编码速度" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Presets}"
                                      SelectedItem="{x:Bind ViewModel.MergePreset, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="分辨率适配" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.MergeFits}"
                                      SelectedItem="{x:Bind ViewModel.MergeFit, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="音频处理" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.MergeAudios}"
                                      SelectedItem="{x:Bind ViewModel.MergeAudio, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind Converter={StaticResource TechLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel Spacing="2">
                            <CheckBox Content="视频参数不一样时，自动重新编码后再合并"
                                      IsChecked="{x:Bind ViewModel.MergeAllowReencode, Mode=TwoWay}" />
                            <CheckBox Content="存成 MKV 时自动生成章节（每段一章）"
                                      IsChecked="{x:Bind ViewModel.MergeChapters, Mode=TwoWay}" />
                            <CheckBox Content="做完后检查文件有没有坏"
                                      IsChecked="{x:Bind ViewModel.MergeVerify, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认输出目录" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.MergeOutputDir, Mode=TwoWay}"
                                     PlaceholderText="留空就存在第一个视频的目录里" />
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.ChooseMergeOutputDirCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 配置文件 ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="配置文件" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ConfigPath}" Style="{StaticResource MonoTextStyle}"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="改动会自动存到这个文件；文件里其它不认识的内容会原样留着，不会弄丢。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开所在目录" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenConfigFolderCommand}" />
                            <Button Content="恢复默认参数" Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.ResetDefaultsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
