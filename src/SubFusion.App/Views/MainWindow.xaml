<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SubFusion.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:SubFusion.App.Pages"
    xmlns:vm="using:SubFusion.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      应用外壳：自绘标题栏 + NavigationView 主导航 + 底部状态栏。
      内容区按 ViewModel.CurrentPage 的类型选择页面模板；导航只改变 ViewModel 状态，
      View 不做任何业务判断、不持有页面状态。
    -->
    <Grid x:Name="Root" AllowDrop="True"
          Background="Transparent"
          DragEnter="Root_DragEnter" DragLeave="Root_DragLeave"
          DragOver="Root_DragOver" Drop="Root_Drop">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏 ==================== -->
        <!--
          左侧：应用图标 + 名称 + 当前页面名。
          右侧：外部媒体工具状态胶囊（常驻，任何页面都能看到 ffmpeg 是否可用）。
          右侧留出 150 DIP 给系统 caption 按钮，胶囊不会被压到按钮下面；
          标题栏本身是拖拽区域，胶囊内的元素不参与拖拽（按钮/文本不拦截点击）。
        -->
        <Grid x:Name="TitleBarRegion" Grid.Row="0" Height="44" Padding="16,0,0,0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app.ico" Width="16" Height="16" />
                <TextBlock Text="SubFusion" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Header}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 工具状态胶囊：圆点 + 简短状态，悬停显示完整版本信息 -->
            <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,150,0"
                    CornerRadius="12" Padding="10,4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    ToolTipService.ToolTip="{Binding ToolText}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{ThemeResource StatusSuccessBrush}"
                             Visibility="{Binding ToolReady, Converter={StaticResource BoolToVisible}}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{ThemeResource StatusDangerBrush}"
                             Visibility="{Binding ToolReady, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding ToolText}" FontSize="12" VerticalAlignment="Center"
                               MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 主导航 ==================== -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="232"
                        CompactPaneLength="48"
                        SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="字幕合并" Tag="subtitle">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="视频合并" Tag="merge">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="视频裁剪" Tag="trim">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="任务中心" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <!--
                  页面承载用 Frame：保留 WinUI 原生的页面切换过渡动效与页面缓存，
                  页面本身只负责展示，状态始终留在各自的 ViewModel 里。
                -->
                <Frame x:Name="ContentFrame" Padding="0">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </NavigationView.Content>
        </NavigationView>

        <!-- ==================== 状态栏 ==================== -->
        <!--
          只保留"当前在做什么"的文字摘要：当前操作 / 任务计数。
          工具状态已移到标题栏胶囊；进度条属于各工作区的内容区（页面里已有）；
          任务中心在左侧导航里就是一级入口，这里不再重复放按钮。
        -->
        <Grid Grid.Row="2" Padding="16,0,16,0" Height="30" ColumnSpacing="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1" Text="{Binding TaskSummary}"
                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
