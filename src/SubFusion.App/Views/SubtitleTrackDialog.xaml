<ContentDialog
    x:Class="SubFusion.App.Views.SubtitleTrackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="字幕轨设置"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <!--
          ContentDialog 的可用宽度由主题资源 ContentDialogMaxWidth / ContentDialogMinWidth 决定，
          控件上的 MaxWidth 属性会被它覆盖（所以之前写的 MaxWidth="1200" 完全不生效，
          对话框被压在默认 548 DIP，右侧「已选字幕轨」整列被裁掉）。
          这里直接改资源，才真正把对话框放宽。
        -->
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">640</x:Double>
    </ContentDialog.Resources>

    <!--
      对应原 SubtitleDialog：候选 / 已选双列表 + 轨道属性编辑。
      宽度说明：ContentDialog 会把内容撑到 ContentDialogMaxWidth（这里覆盖为 1100），
      但前提是内容自身要 Stretch 且不给死宽度；只写 MinWidth 会导致内容被按最小宽度压缩。
    -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Width="1060" Height="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock x:Name="VideoLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="（勾选要合并的字幕，可设置语言与默认轨）" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 两侧列表等宽且可收缩（最小 220），中间按钮固定，避免窄屏时把右列挤出对话框 -->
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- 左：候选字幕 -->
            <Border Grid.Column="0" CornerRadius="6" Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="候选字幕" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListView x:Name="CandidateList" Grid.Row="1" SelectionMode="Multiple"
                              DoubleTapped="CandidateList_DoubleTapped">
                        <!-- 只显示文件名，整条路径放进工具提示，长路径不再把列表撑宽 -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource FileName}}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 中：操作按钮 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="10,0">
                <Button Content="添加 →" Width="96" Click="OnAdd" />
                <Button Content="← 移除" Width="96" Click="OnRemove" />
                <Button Content="浏览…" Width="96" Click="OnBrowse" />
            </StackPanel>

            <!-- 右：已选字幕轨 -->
            <Border Grid.Column="2" CornerRadius="6" Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="已选字幕轨" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListView x:Name="SelectedList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="SelectedList_SelectionChanged"
                              DoubleTapped="SelectedList_DoubleTapped" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="上移" Width="80" Click="OnMoveUp" />
                        <Button Content="下移" Width="80" Click="OnMoveDown" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 下：轨道属性（用 Grid 而不是横向 StackPanel：窄屏下不会被挤出对话框） -->
        <Border Grid.Row="2" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="语言：" VerticalAlignment="Center" FontSize="12" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LangCombo"
                          HorizontalAlignment="Stretch" SelectionChanged="OnLangChanged" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="轨道名：" VerticalAlignment="Center" FontSize="12" />
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TitleBox"
                         HorizontalAlignment="Stretch" TextChanged="OnTitleChanged" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="（默认轨只会有一个）" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                            Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="DefaultCheck" Content="默认轨"
                              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                    <CheckBox x:Name="ForcedCheck" Content="强制显示"
                              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
