<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI 3 桌面应用（未打包 / unpackaged）。
    WindowsPackageType=None + WindowsAppSDKSelfContained=true：
    无需 MSIX 安装、无需目标机预装 Windows App SDK 运行时，直接双击 exe 即可运行。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SubFusion.App</RootNamespace>
    <AssemblyName>SubFusion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Win32 文件图标（资源管理器 / 任务栏 / 单文件发布后的 EXE）。
      之前只有运行时的 AppWindow.SetIcon，没有这个属性，所以编译出的 exe 里
      根本没有 RT_GROUP_ICON 资源——单文件发布把 exe 拷到桌面后就显示成白纸图标。
      ApplicationIcon 由 apphost 在链接阶段写入 PE 资源；单文件打包（bundle）
      只在其后追加数据段，不会覆盖这一资源，因此目录发布与单文件发布都生效。
    -->
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
    <!--
      版本元数据：写进 PE 的 VS_VERSION_INFO，资源管理器「属性 → 详细信息」里能看到。
      Core/Constants.cs 的 AppVersion 用于标题栏；发布新版本时两处一起改，
      否则文件属性会一直停在旧版本号。
    -->
    <Version>2.3.0</Version>
    <FileVersion>2.3.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Product>SubFusion</Product>
    <Company>Utpop</Company>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!--
      单文件 EXE 可以被用户任意改名（例如 SubFusion-v2.3.exe），但 WinUI 3 默认
      用 AssemblyName 生成的 SubFusion.pri 是按 exe 名查资源的：改名后运行时找不到
      PRI，MainWindow.InitializeComponent() 抛 XamlParseException 启动即崩。
      这是 WindowsAppSDK 的已知问题（microsoft/WindowsAppSDK#6248 / microsoft-ui-xaml#10966）。
      官方规避办法：把 PRI 固定命名为 resources.pri，运行时按这个名字查找，与 exe 名无关。
    -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultLanguage>zh-CN</DefaultLanguage>
  </PropertyGroup>

  <!--
    NETSDK1244 的定向降级。

    SDK 建议去掉 IncludeAllContentForSelfExtract、改用内存内单文件；但 Windows App SDK 的
    单文件 targets 依赖「内容解压到磁盘 + SxS 重定向」来定位原生 DLL 与嵌入的 resources.pri，
    去掉该属性会让发布产物无法启动，所以属性必须保留。

    抑制只能写成无条件属性：PublishSingleFile / PublishProfile 在单文件发布时由 .pubxml
    在项目求值之后才设置，写成条件属性对这条诊断无效（已在 csproj 与 Directory.Build.props
    两处实测）。NETSDK1244 本身只在 IncludeAllContentForSelfExtract=true 时产生，
    因此无条件降级不会掩盖其它警告。
  -->
  <PropertyGroup>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1244</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubFusion.Core\SubFusion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      图标资源（由 tools/make_icons.py 从 assets/app-icon.png 生成）：
        Assets/app.ico       运行期 AppWindow.SetIcon 读取（含 16~256 十个尺寸）
        Assets/app-icon.png  标题栏左侧 16px 位图（ms-appx 引用；ico 在 16px 下边缘发虚）
      PE 里的文件图标来自上面的 <ApplicationIcon>，两者共用同一个 app.ico。
    -->
    <Content Include="..\..\app.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app-icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinUI 3 的 XAML 编译产物（.xbf）与资源索引（.pri）默认只进入 build 输出，
    dotnet publish 不会自动带上，不补就会出现「发布目录里的 exe 启动即崩」。

    **目录发布与单文件发布都必须补，不能加 Condition。**

    v2.3 单文件版「双击即崩」的根因就是这个 Target 上写了
    Condition="'$(PublishSingleFile)' != 'true'"。实测（-getItem:_FilesToBundle）：
      · 带 Condition 时，单文件 bundle 里是 { xaml: 12, xbf: 0 }；
      · 目录发布里是 { xbf: 12 }。
    单文件 bundle 靠 Content 解压到 %TEMP%\.net\SubFusion\<内容哈希>\ 运行，
    而 WindowsAppSDK 只把 **.xaml 源文件**带进去；同一份产物里的 SubFusion.pri
    登记的却是 MainWindow.xbf。Application.LoadComponent 按 PRI 找 .xbf 找不到，
    于是 MainWindow.InitializeComponent() 抛 XamlParseException，进程启动即结束。

    关键约束：这个 Target 必须跑在 **_ComputeFilesToBundle 之前**。
    _ComputeFilesToBundle 直接以 ResolvedFileToPublish 为输入，而
    ComputeFilesToPublish 的 AfterTargets 跑在打包之后，在那里补项目对 bundle 无效
    （目录发布不受影响，所以这个坑只在单文件形态暴露）。
  -->
  <Target Name="IncludeXamlArtifactsInPublish"
          BeforeTargets="_ComputeFilesToBundle;ComputeFilesToPublish">
    <ItemGroup>
      <!-- 收集全部 XAML 编译产物（App / Views / Pages / Styles），
           避免新增页面或样式字典后发布目录漏拷 .xbf 导致启动失败。 -->
      <_AppXamlArtifact Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_AppXamlArtifact)"
                             RelativePath="%(_AppXamlArtifact.RecursiveDir)%(_AppXamlArtifact.Filename)%(_AppXamlArtifact.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />

      <!--
        【关键】把 .xaml 源文件从发布清单里去掉，只留 .xbf。

        单文件发布开了 IncludeAllContentForSelfExtract=true，会把 **Content 项**一并
        解压到 %TEMP%\.net\SubFusion\<内容哈希>\。WinUI 的 Page/XAML 项同时也作为
        Content 交付，于是解包目录里 .xaml 与 .xbf **同时存在**；而目录发布只有 .xbf。
        LoadComponent 在两者都在时解析失败（.xaml 含 x:Bind/x:DataType 等需要编译期
        代码生成的标记，运行期无法独立解析），抛 XamlParseException，
        栈顶固定在 MainWindow.InitializeComponent() —— 这就是「单文件版双击即崩、
        目录版正常」的真正原因，和缺 .xbf 无关（补了 .xbf 之后仍然崩）。

        实测对比（-getItem:_FilesToBundle）：
          修复前：每页 xaml + xbf 各一份（26 个 xaml 相关条目），崩溃；
          目录发布：只有 xbf，正常。
        所以单文件形态必须让 XAML 布局与目录发布完全一致：只留 .xbf。
      -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.xaml'" />

      <!-- SubFusion.pri 已在 _FilesToBundle 中由 MSIX targets 提供一份，这里不再重复添加，
           否则 bundle 内会出现两条同名条目（实测重复 2 次）。 -->
    </ItemGroup>
  </Target>

</Project>
