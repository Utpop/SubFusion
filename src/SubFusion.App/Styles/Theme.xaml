<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      设计令牌（Design Tokens）。
      所有页面只允许引用这里的资源，不在页面内散落硬编码颜色。
      语义色分三档主题：Default=深色、Light=浅色、HighContrast=高对比度。
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ==================== 深色（Default） ==================== -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="StatusSuccessColor">#FF6CCB5F</Color>
            <Color x:Key="StatusWarningColor">#FFFFD15C</Color>
            <Color x:Key="StatusDangerColor">#FFFF99A4</Color>
            <Color x:Key="StatusNeutralColor">#FFA0A0A0</Color>
            <Color x:Key="StatusInfoColor">#FF6BB8FF</Color>
            <Color x:Key="StatusSuccessTintColor">#266CCB5F</Color>
            <Color x:Key="StatusWarningTintColor">#26FFD15C</Color>
            <Color x:Key="StatusDangerTintColor">#26FF99A4</Color>
            <Color x:Key="StatusInfoTintColor">#266BB8FF</Color>
        </ResourceDictionary>

        <!-- ==================== 浅色 ==================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="StatusSuccessColor">#FF0F7B0F</Color>
            <Color x:Key="StatusWarningColor">#FF9A6700</Color>
            <Color x:Key="StatusDangerColor">#FFC42B1C</Color>
            <Color x:Key="StatusNeutralColor">#FF616161</Color>
            <Color x:Key="StatusInfoColor">#FF0F6CBD</Color>
            <Color x:Key="StatusSuccessTintColor">#1A0F7B0F</Color>
            <Color x:Key="StatusWarningTintColor">#1A9A6700</Color>
            <Color x:Key="StatusDangerTintColor">#1AC42B1C</Color>
            <Color x:Key="StatusInfoTintColor">#1A0F6CBD</Color>
        </ResourceDictionary>

        <!-- ==================== 高对比度 ==================== -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="StatusSuccessColor">#FF00FF00</Color>
            <Color x:Key="StatusWarningColor">#FFFFFF00</Color>
            <Color x:Key="StatusDangerColor">#FFFF0000</Color>
            <Color x:Key="StatusNeutralColor">#FFFFFFFF</Color>
            <Color x:Key="StatusInfoColor">#FF00FFFF</Color>
            <Color x:Key="StatusSuccessTintColor">#3300FF00</Color>
            <Color x:Key="StatusWarningTintColor">#33FFFF00</Color>
            <Color x:Key="StatusDangerTintColor">#33FF0000</Color>
            <Color x:Key="StatusInfoTintColor">#3300FFFF</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 语义画刷：状态色只从这里取 -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{ThemeResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{ThemeResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{ThemeResource StatusDangerColor}" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="{ThemeResource StatusNeutralColor}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{ThemeResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusSuccessTintBrush" Color="{ThemeResource StatusSuccessTintColor}" />
    <SolidColorBrush x:Key="StatusWarningTintBrush" Color="{ThemeResource StatusWarningTintColor}" />
    <SolidColorBrush x:Key="StatusDangerTintBrush" Color="{ThemeResource StatusDangerTintColor}" />
    <SolidColorBrush x:Key="StatusInfoTintBrush" Color="{ThemeResource StatusInfoTintColor}" />

    <!-- 页面与卡片内边距 -->
    <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- 字号层级 -->
    <x:Double x:Key="PageTitleSize">26</x:Double>
    <x:Double x:Key="SectionTitleSize">15</x:Double>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="CaptionSize">12</x:Double>

    <!-- 行高 -->
    <x:Double x:Key="ListItemHeight">44</x:Double>

    <!-- 弹窗宽度（ContentDialog 只能通过主题资源控制） -->
    <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
</ResourceDictionary>
