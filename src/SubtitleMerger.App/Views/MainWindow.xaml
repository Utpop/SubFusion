<Window
    x:Class="SubtitleMerger.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      界面重新设计：原生 WinUI 3 控件 + Fluent 2 主题。
      与原 Tk 版覆盖同一批交互入口，但布局改为「应用栏 / 拖放区 / 工具条 / 任务表 /
      设置分页 / 底部操作栏」的纵向流式结构，不再复刻自绘控件。
    -->
    <Grid x:Name="Root" AllowDrop="True"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          DragEnter="Root_DragEnter" DragLeave="Root_DragLeave"
          DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 1.1：任务表与设置区按 4:6 分配剩余高度（原来表格按 * 吃满、设置区只有固定 236），
                 这样 1440p/1080p 下设置页也有足够空间；小窗口时任务表先收紧到 120。 -->
            <RowDefinition Height="0.38*" MinHeight="110" />
            <RowDefinition Height="0.62*" MinHeight="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 应用栏 ==================== -->
        <Grid Grid.Row="0" Padding="20,18,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="字幕视频批量合并" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="软字幕 / 硬字幕 · 批量处理 · 默认不重编码"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="10,5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding FfmpegPillColor, Converter={StaticResource HexToBrush}}" />
                        <TextBlock Text="{Binding FfmpegPillText}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Button Content="更改" Command="{Binding ChooseFfmpegCommand}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 拖放区 ==================== -->
        <Grid Grid.Row="1" Margin="20,8,20,10" Height="108">
            <Rectangle x:Name="DropOutline" RadiusX="8" RadiusY="8"
                       Stroke="#9CB8D8" StrokeThickness="2" StrokeDashArray="5,4"
                       Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock x:Name="DropMainText" Text="把视频、字幕或文件夹拖到这里"
                           FontSize="15" TextAlignment="Center"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="DropSubText"
                           Text="也可以点下方按钮添加 · 支持 MP4 / MKV / MOV 视频，SRT / ASS / SUP 字幕"
                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 工具条 ==================== -->
        <Grid Grid.Row="2" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="添加视频" Command="{Binding AddVideosCommand}" />
                <Button Content="添加字幕" Command="{Binding AddSubtitlesCommand}" />
                <Button Content="添加文件夹" Command="{Binding AddFolderCommand}" />
                <Button Content="移除选中" Command="{Binding RemoveSelectedCommand}" Margin="8,0,0,0" />
                <Button Content="清空" Command="{Binding ClearAllCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CountText}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- ==================== 待处理文件表格 ==================== -->
        <Border Grid.Row="3" Margin="20,0,20,10" CornerRadius="8" Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,12,16,8">
                    <TextBlock Text="待处理文件" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="双击行可编辑字幕轨，右键有更多操作" FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Bottom" />
                </StackPanel>

                <ListView x:Name="JobsList" Grid.Row="1" Margin="12,0,12,12"
                          ItemsSource="{Binding Jobs}" SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="JobsList_SelectionChanged"
                          DoubleTapped="JobsList_DoubleTapped"
                          RightTapped="JobsList_RightTapped">
                    <!--
                      1.1：显式启用 UI 虚拟化。默认面板在一次性写入大量条目（几百上千个视频）时
                      会把每一行都实例化，行模板里有 9 个 TextBlock，重负载下内存与首帧耗时都很可观；
                      ItemsStackPanel 只创建可视区域内的行（约 20 行），滚动时复用。
                    -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="30" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <!-- 表头放进 ListView.Header，随内容一起横向滚动，列宽与数据行完全一致 -->
                    <ListView.Header>
                        <Grid MinWidth="1260" Padding="0,6"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250*" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="250*" />
                                <ColumnDefinition Width="158*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="230*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="视频" FontWeight="SemiBold" Margin="8,0" />
                            <TextBlock Grid.Column="1" Text="时长" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="分辨率" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="字幕轨" FontWeight="SemiBold" Margin="8,0" />
                            <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="进度" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="速度" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="剩余" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="输出文件" FontWeight="SemiBold" Margin="8,0" />
                        </Grid>
                    </ListView.Header>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="1260" Padding="0,5"
                                  Background="{Binding StateTag, Converter={StaticResource StateToBrush}, ConverterParameter=Back}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250*" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="250*" />
                                    <ColumnDefinition Width="158*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="230*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="8,0" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}"
                                           Foreground="{Binding StateTag, Converter={StaticResource StateToBrush}, ConverterParameter=Fore}" />
                                <TextBlock Grid.Column="1" TextAlignment="Center" Text="{Binding DurationText}" />
                                <TextBlock Grid.Column="2" TextAlignment="Center" Text="{Binding Resolution}" />
                                <TextBlock Grid.Column="3" Margin="8,0" TextTrimming="CharacterEllipsis" Text="{Binding SubsText}" />
                                <TextBlock Grid.Column="4" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding StateText}"
                                           Foreground="{Binding StateTag, Converter={StaticResource StateToBrush}, ConverterParameter=Fore}" />
                                <TextBlock Grid.Column="5" TextAlignment="Center" Text="{Binding ProgressText}" />
                                <TextBlock Grid.Column="6" TextAlignment="Center" Text="{Binding Speed}" />
                                <TextBlock Grid.Column="7" TextAlignment="Center" Text="{Binding Eta}" />
                                <TextBlock Grid.Column="8" Margin="8,0" TextTrimming="CharacterEllipsis" Text="{Binding OutputName}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ==================== 设置分页 ==================== -->
        <!--
          1.1：原来的固定 Height=252 在 1080p + 125% 缩放（可用高约 816 DIP）下
          会把底部操作栏挤出窗口。改为随窗口拉伸：大窗口里按内容撑开，
          小窗口里缩到最小 236 并出现页内滚动条，任何尺寸下都不再裁掉按钮。
        -->
        <Border Grid.Row="4" Margin="20,0,20,8" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Pivot x:Name="SettingsPivot">
                <!-- 原生 Pivot 标题字号偏大，用 HeaderTemplate 统一收小，保留选中指示线与视觉状态 -->
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="15" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <!-- 输出 -->
                <PivotItem Header="输出">
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="16,8,16,16">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="输出容器" Width="70" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Width="110" ItemsSource="{Binding Containers}"
                                          SelectedItem="{Binding Container, Mode=TwoWay}" />
                                <TextBlock Text="字幕方式" Width="70" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Width="120" ItemsSource="{Binding Modes}"
                                          SelectedItem="{Binding Mode, Mode=TwoWay}" />
                                <TextBlock Text="文件名后缀" Width="80" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <TextBox Width="110" Text="{Binding Suffix, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="输出目录" Width="70" VerticalAlignment="Center" FontSize="12" />
                                <TextBox MinWidth="360" HorizontalAlignment="Stretch"
                                         Text="{Binding OutputDir, Mode=TwoWay}" />
                                <Button Content="浏览" Command="{Binding ChooseOutdirCommand}" />
                                <Button Content="同源文件" Command="{Binding UseSourceDirCommand}" />
                                <CheckBox Content="输出目录同源同步" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="开启后，每次添加不同目录的文件会自动把输出目录同步为该源文件所在目录；设置会持久保存。"
                                          IsChecked="{Binding SyncOutputDir, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <CheckBox Content="保留视频原有字幕轨" IsChecked="{Binding KeepExistingSubs, Mode=TwoWay}" />
                                <CheckBox Content="保留元数据" IsChecked="{Binding KeepMetadata, Mode=TwoWay}" />
                                <CheckBox Content="允许覆盖同名文件" IsChecked="{Binding Overwrite, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="处理完成后校验输出（核对字幕轨、音轨与时长）"
                                      IsChecked="{Binding Verify, Mode=TwoWay}" />

                            <!-- 破坏性操作：默认关闭，勾选后仍需确认；只有校验通过才会删除原件 -->
                            <CheckBox Content="合并成功后替换原文件（删除原视频与已合并字幕，不保留 _sub 副本）"
                                      IsChecked="{Binding ReplaceSource, Mode=TwoWay}" />
                            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{Binding ReplaceSource}"
                                     Title="注意：该选项会删除原始文件"
                                     Message="仅在合并完成且输出校验通过时删除原视频与已合并的字幕；输出沿用原视频文件名。校验失败、改名失败或删除失败都会保留原件。" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- 编码 -->
                <PivotItem Header="编码">
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="16,8,16,16">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="视频编码" Width="70" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Width="150" ItemsSource="{Binding Vcodecs}"
                                          SelectedItem="{Binding Vcodec, Mode=TwoWay}" />
                                <TextBlock Text="音频编码" Width="70" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Width="110" ItemsSource="{Binding Acodecs}"
                                          SelectedItem="{Binding Acodec, Mode=TwoWay}" />
                                <TextBlock Text="并发任务" Width="70" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <NumberBox Width="120" Minimum="1" Maximum="4" SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding Workers, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="CRF" Width="70" VerticalAlignment="Center" FontSize="12" />
                                <NumberBox Width="120" Minimum="0" Maximum="51" SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding Crf, Mode=TwoWay}" />
                                <TextBlock Text="preset" Width="70" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Width="140" ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding Preset, Mode=TwoWay}" />
                                <TextBlock Text="（仅重新编码时生效）" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- 字幕与匹配 -->
                <PivotItem Header="字幕与匹配">
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Padding="16,8,16,16">
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <CheckBox Content="字幕自动转为 UTF-8（中文/日文不乱码）"
                                          IsChecked="{Binding ConvertEncoding, Mode=TwoWay}" />
                                <CheckBox Content="扫描子文件夹" IsChecked="{Binding Recursive, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="文件名匹配阈值" VerticalAlignment="Center" FontSize="12" />
                                <NumberBox Width="140" Minimum="0.4" Maximum="1.0" SmallChange="0.02"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding Threshold, Mode=TwoWay}" />
                                <Button Content="重新匹配" Command="{Binding RematchCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                            <CheckBox Content="硬字幕时叠加全部字幕轨（关闭则只烧录第一条）"
                                      IsChecked="{Binding HardMulti, Mode=TwoWay}" />
                            <InfoBar Severity="Warning" IsClosable="False"
                                     IsOpen="{Binding HintVisible}" Message="{Binding HintText}" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- 日志 -->
                <PivotItem Header="日志">
                    <!-- 原 tk.Text(state=disabled) 仍允许选中复制，故用可选中文本的 TextBlock -->
                    <ScrollViewer x:Name="LogScroll" Padding="12,4"
                                  VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding LogText}" IsTextSelectionEnabled="True"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Border>

        <!-- ==================== 底部操作栏 ==================== -->
        <Grid Grid.Row="5" Margin="20,0,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Grid.Row="0" Grid.Column="0" Content="开始处理"
                    Style="{StaticResource AccentButtonStyle}" Padding="34,10"
                    Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
            <Button Grid.Row="0" Grid.Column="1" Content="停止" Margin="10,0,0,0"
                    Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
            <StackPanel Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right" Spacing="6" MinWidth="300">
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar Width="300" Height="6" Value="{Binding OverallProgress}"
                             Maximum="{Binding OverallMaximum}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal"
                        Spacing="10" Margin="0,14,0,0">
                <Button Content="打开输出目录" Command="{Binding OpenOutputDirCommand}" />
                <Button Content="导出报告" Command="{Binding ExportReportCommand}" />
                <Button Content="清空日志" Command="{Binding ClearLogCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
