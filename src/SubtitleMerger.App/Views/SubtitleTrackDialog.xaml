<ContentDialog
    x:Class="SubtitleMerger.App.Views.SubtitleTrackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="字幕轨设置"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MaxWidth="1200"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- 对应原 SubtitleDialog：候选 / 已选双列表 + 轨道属性编辑 -->
    <Grid Width="1040" Height="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock x:Name="VideoLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="（勾选要合并的字幕，可设置语言与默认轨）" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：候选字幕 -->
            <Border Grid.Column="0" CornerRadius="6" Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="候选字幕" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListView x:Name="CandidateList" Grid.Row="1" SelectionMode="Multiple"
                              DoubleTapped="CandidateList_DoubleTapped" />
                </Grid>
            </Border>

            <!-- 中：操作按钮 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="10,0">
                <Button Content="添加 →" Width="96" Click="OnAdd" />
                <Button Content="← 移除" Width="96" Click="OnRemove" />
                <Button Content="浏览…" Width="96" Click="OnBrowse" />
            </StackPanel>

            <!-- 右：已选字幕轨 -->
            <Border Grid.Column="2" CornerRadius="6" Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="已选字幕轨" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListView x:Name="SelectedList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="SelectedList_SelectionChanged"
                              DoubleTapped="SelectedList_DoubleTapped" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="上移" Width="80" Click="OnMoveUp" />
                        <Button Content="下移" Width="80" Click="OnMoveDown" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 下：轨道属性 -->
        <Border Grid.Row="2" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="语言：" VerticalAlignment="Center" FontSize="12" />
                <ComboBox x:Name="LangCombo" Width="140" SelectionChanged="OnLangChanged" />
                <TextBlock Text="轨道名：" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                <TextBox x:Name="TitleBox" Width="170" TextChanged="OnTitleChanged" />
                <CheckBox x:Name="DefaultCheck" Content="默认轨" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                <CheckBox x:Name="ForcedCheck" Content="强制显示" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                <TextBlock Text="（默认轨只会有一个）" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
